<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:parks="https://medleyt.github.io/CSE445Assignment4/"
           targetNamespace="https://medleyt.github.io/CSE445Assignment4/"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <xs:element name="NationalParks" type="parks:NationalParksType"/>

  <!-- The directory contains one or more parks. -->
  <xs:complexType name="NationalParksType">
    <xs:sequence>
      <xs:element name="NationalPark"
                  type="parks:NationalParkType"
                  minOccurs="1"
                  maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Each park has a name, phone numbers, and an address. -->
  <xs:complexType name="NationalParkType">
    <xs:sequence>
      <xs:element name="Name" type="xs:string"
                  minOccurs="1" maxOccurs="1"/>
      <xs:element name="Phone" type="xs:string"
                  minOccurs="1" maxOccurs="unbounded"/>
      <xs:element name="Address" type="parks:AddressType"
                  minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
    <xs:attribute name="Rating" type="xs:decimal" use="optional"/>
  </xs:complexType>

  <!-- NearestAirport is required for every address. -->
  <xs:complexType name="AddressType">
    <xs:sequence>
      <xs:element name="Number" type="xs:string"
                  minOccurs="1" maxOccurs="1"/>
      <xs:element name="Street" type="xs:string"
                  minOccurs="1" maxOccurs="1"/>
      <xs:element name="City" type="xs:string"
                  minOccurs="1" maxOccurs="1"/>
      <xs:element name="State" type="xs:string"
                  minOccurs="1" maxOccurs="1"/>
      <xs:element name="Zip" type="xs:string"
                  minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
    <xs:attribute name="NearestAirport" type="xs:string" use="required"/>
  </xs:complexType>

</xs:schema>
